# Copy this file to .env (docker compose reads .env in this directory automatically).
#
#   cp .env.example .env
#
# .env is git-ignored — put real tokens/secrets there, never in this example file.

# Required only when ASR_ENGINE=whisperx and diarization (speaker labels) is used.
# Get a token at https://huggingface.co/settings/tokens and accept the pyannote model terms.
HF_TOKEN=

# Optional overrides for the asr-webservice container.
# See docs/environmental-variables.md for the full list.
ASR_ENGINE=openai_whisper
ASR_MODEL=base
